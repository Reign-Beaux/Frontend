---
import MainLayout from "../layouts/MainLayout.astro";
import Presentation from "../components/about/Presentation.astro";
import Focus from "../components/about/Focus.astro";
import Skills from "../components/about/Skills.astro";
import WorkExperience from "../components/about/WorkExperience.astro";
import PersonalProjects from "../components/about/PersonalProjects.astro";
---

<MainLayout title="Saúl Antonio | Sobre Mí">
  <div class="aboutMe">
    <Presentation />
    <Focus />
    <Skills />
    <WorkExperience />
    <PersonalProjects />
  </div>
</MainLayout>

<style lang="scss">
  .aboutMe {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 4rem;
  }
</style>
