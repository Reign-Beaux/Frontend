---
const { pathname } = Astro.url;

const navLinks = [
  { href: "/", label: "Inicio" },
  { href: "/about", label: "Sobre mí" },
  { href: "/blog", label: "Blog" },
];
---

<header class="header" role="banner">
  <div class="container">
    <nav class="headerNav" role="navigation">
      <ul class="socialNetworks">
        <li>
          <a
            href="https://github.com/Reign-Beaux"
            target="_blank"
            aria-label="Perfil de GitHub"
            rel="noreferrer noopener">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              class="bi bi-github"
              viewBox="0 0 16 16">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8"></path>
            </svg>
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/saul-antonio-morquecho-cela-/"
            target="_blank"
            aria-label="Perfil de LinkedInd"
            rel="noreferrer noopener">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="32"
              height="32"
              class="bi bi-linkedin"
              viewBox="0 0 16 16">
              <path d="M0 1.146C0 .513.526 0 1.175 0h13.65C15.474 0 16 .513 16 1.146v13.708c0 .633-.526 1.146-1.175 1.146H1.175C.526 16 0 15.487 0 14.854zm4.943 12.248V6.169H2.542v7.225zm-1.2-8.212c.837 0 1.358-.554 1.358-1.248-.015-.709-.52-1.248-1.342-1.248S2.4 3.226 2.4 3.934c0 .694.521 1.248 1.327 1.248zm4.908 8.212V9.359c0-.216.016-.432.08-.586.173-.431.568-.878 1.232-.878.869 0 1.216.662 1.216 1.634v3.865h2.401V9.25c0-2.22-1.184-3.252-2.764-3.252-1.274 0-1.845.7-2.165 1.193v.025h-.016l.016-.025V6.169h-2.4c.03.678 0 7.225 0 7.225z"></path>
            </svg>
          </a>
        </li>
      </ul>
      <ul class="navLinks">
        {navLinks.map((link) => (
          <li>
            <a
              href={link.href}
              class={pathname === link.href || (link.href !== "/" && pathname.startsWith(link.href)) ? "active" : ""}
            >
              {link.label}
            </a>
          </li>
        ))}
        <li>
          <button id="themeToggle" class="themeToggle" aria-label="Cambiar tema" onclick="toggleTheme()">
            <svg class="sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
            <svg class="moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          </button>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style lang="scss">
  @use "../styles/variables";

  .header {
    position: sticky;
    top: 0;
    background-color: variables.$nav-bg;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    z-index: 1000;
    border-bottom: 1px solid variables.$border-color;
    padding: clamp(0.75rem, 2vh, 1.2rem) 0;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .headerNav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;

    @media (max-width: 640px) {
      justify-content: center;
    }
  }

  .themeToggle {
    background: none;
    border: 1px solid variables.$border-color;
    color: variables.$text-color;
    cursor: pointer;
    padding: clamp(6px, 1.5vw, 8px);
    border-radius: variables.$border-radius;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;

    &:hover {
      background-color: variables.$bg-accent;
      color: variables.$accent-color;
      border-color: variables.$accent-color;
    }

    svg {
      width: clamp(18px, 4vw, 20px);
      height: clamp(18px, 4vw, 20px);
    }

    .sun { display: none; }
    .moon { display: block; }

    :global([data-theme="light"]) & {
      .sun { display: block; }
      .moon { display: none; }
    }
  }

  .socialNetworks {
    display: flex;
    gap: clamp(1rem, 3vw, 1.5rem);
    list-style: none;
    align-items: center;
    padding: 0;
    margin: 0;

    a {
      display: block; // Ensure proper hit area
      line-height: 0;
    }

    svg {
      width: clamp(24px, 5vw, 32px);
      height: clamp(24px, 5vw, 32px);
      fill: variables.$text-color;
      transition: fill 0.2s ease, transform 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
      cursor: pointer;
      display: block;
    }

    a:hover svg {
      fill: variables.$accent-color; // Use accent color
      transform: translateY(-2px); // Motion-driven: slight lift
    }
  }

  .navLinks {
    display: flex;
    gap: clamp(1rem, 4vw, 2rem);
    list-style: none;
    align-items: center;
    margin: 0;
    padding: 0;

    li {
      margin: 0;
    }

    a {
      text-decoration: none;
      color: variables.$text-color;
      font-size: clamp(0.9rem, 2.5vw, 1rem);
      font-weight: 500;
      transition: color 0.2s ease;
      position: relative;
      padding: 0.5rem 0; // Better hit area

      &::after {
        content: "";
        position: absolute;
        width: 0;
        height: 2px;
        bottom: 0;
        left: 0;
        background-color: variables.$accent-color; // Use accent color
        transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1); // Smoother easing
      }

      &:hover {
        color: variables.$accent-color;

        &::after {
          width: 100%;
        }
      }

      &.active {
        color: variables.$accent-color;

        &::after {
          width: 100%;
        }
      }
    }
  }
</style>
