<section class="getInTouch fade-in delay-3">
  <h2 class="contactTitle">¿Listo para trabajar juntos?</h2>
  <p class="contactDescription">
    Estoy disponible para nuevos proyectos y colaboraciones. Si buscas un desarrollador comprometido con
    la calidad y la innovación, hablemos.
  </p>
  <a href="mailto:hola@saulantonio.com" class="linkButton linkButton-large">
    Contáctame
  </a>
</section>

<style lang="scss">
  @use "../../styles/variables";

  .getInTouch {
    margin-bottom: clamp(3rem, 10vh, 5rem);
    padding: clamp(2rem, 8vw, 4rem) clamp(1rem, 5vw, 2rem);
    background: linear-gradient(135deg, variables.$card-bg, rgba(37, 99, 235, 0.05));
    border-radius: variables.$border-radius;
    text-align: center;
    border: 1px solid variables.$border-color;
    box-shadow: variables.$shadow-md;
    position: relative;
    overflow: hidden;

    &::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 4px;
      background: variables.$primary-color; // Solid primary color
    }
  }

  .contactTitle {
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    margin-bottom: 1rem;
    color: variables.$primary-color; // Solid primary color
    font-weight: 700;
  }

  .contactDescription {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    max-width: 650px;
    margin: 0 auto 2.5rem;
    color: variables.$text-color;
    opacity: 0.9;
  }

  @media (max-width: 768px) {
    .contactTitle {
      // Removed fixed size, using clamp above
    }
  }
</style>
