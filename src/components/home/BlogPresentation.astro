---
import { articles } from "../../data/articles";

const latestArticles = articles.slice(0, 4);
---

<section class="fade-in delay-3">
  <h2 class="sectionTitle">Últimos Artículos</h2>
  <div class="cardGrid">
    {latestArticles.map((article) => (
      <article class="blogCard">
        <span class="blogDate">{article.createdAt.toLocaleDateString("es-ES")}</span>
        <h3 class="blogTitle">
          <a href={`/blog/${article.slug}`}>{article.title}</a>
        </h3>
        <p>{article.summary}</p>
        <a href={`/blog/${article.slug}`} class="readMore">
          Leer más →
        </a>
      </article>
    ))}
  </div>
  <div style="text-align: center; margin-top: 2rem;">
    <a href="/blog" class="linkButton goToBlog">
      Ver todos los artículos
    </a>
  </div>
</section>

<style lang="scss">
  @use "../../styles/variables";

  .sectionTitle {
    font-size: 2rem;
    margin-bottom: 2rem;
    text-align: center;
    position: relative;
    display: inline-block;
    left: 50%;
    transform: translateX(-50%);

    &::after {
      content: "";
      display: block;
      width: 60px;
      height: 4px;
      background: variables.$accent-color;
      margin: 10px auto 0;
      border-radius: 2px;
    }
  }

  .cardGrid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: clamp(1rem, 3vw, 2rem);
    margin-bottom: 2rem;
  }

  .blogCard {
    background-color: variables.$card-bg;
    border-radius: variables.$border-radius;
    padding: 30px;
    box-shadow: variables.$shadow-sm;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    border: 1px solid variables.$border-color;

    &:hover {
      transform: translateY(-5px);
      box-shadow: variables.$shadow-md;
    }

    p {
      margin-bottom: 16px;
    }
  }

  .blogTitle {
    font-size: 1.5rem;
    margin-bottom: 0.8rem;

    a {
      text-decoration: none;
      color: variables.$text-color;
      transition: color 0.2s ease;

      &:hover {
        color: variables.$accent-color;
      }
    }
  }

  .blogDate {
    font-size: 0.9rem;
    color: variables.$accent-color;
    font-weight: 600;
    margin-bottom: 1rem;
    display: block;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .readMore {
    color: variables.$accent-color;
    text-decoration: none;
    font-weight: 600;

    &:hover {
      text-decoration: underline;
    }
  }

  .goToBlog {
    background: transparent;
    border: 2px solid variables.$accent-color;
    color: variables.$accent-color;

    &:hover {
      background: variables.$accent-color;
      color: white;
    }
  }
</style>
