---
import Accordion from "../Accordion.astro";
---

<Accordion label="Habilidades técnicas" className="fade-in delay-3">
  <div class="skills">
    <div class="grouped">
      <h3 class="sectionTitle">Buenas prácticas y herramientas</h3>
      <div class="skillsGrid">
        <span class="skillTag">GitHub</span>
        <span class="skillTag">GitLab</span>
        <span class="skillTag">Docker</span>
        <span class="skillTag">Docker Compose</span>
        <span class="skillTag">Clean Architecture</span>
        <span class="skillTag">Clean Code</span>
        <span class="skillTag">Principios SOLID</span>
      </div>
    </div>

    <div class="grouped">
      <h3 class="sectionTitle">Frontend</h3>
      <div class="skillsGrid">
        <span class="skillTag">Vite</span>
        <span class="skillTag">React</span>
        <span class="skillTag">Astro</span>
        <span class="skillTag">HTML</span>
        <span class="skillTag">TypeScript</span>
        <span class="skillTag">JavaScript</span>
        <span class="skillTag">CSS Modules</span>
      </div>

      <h4 class="subTitle">Bibliotecas</h4>
      <div class="skillsGrid">
        <span class="skillTag">Sass</span>
        <span class="skillTag">React Router Dom</span>
        <span class="skillTag">Axios</span>
        <span class="skillTag">React Hook Form</span>
        <span class="skillTag">Yup</span>
        <span class="skillTag">Zustand</span>
      </div>
    </div>

    <div class="grouped">
      <h3 class="sectionTitle">Backend</h3>
      <div class="skillsGrid">
        <span class="skillTag">.NET 7/8/9/10</span>
        <span class="skillTag">.NET Framework 4.5</span>
        <span class="skillTag">C#</span>
        <span class="skillTag">APIs REST</span>
        <span class="skillTag">Background Services / Hosted Services</span>
        <span class="skillTag">Middlewares</span>
        <span class="skillTag">JWT</span>
        <span class="skillTag">Refresh Token</span>
        <span class="skillTag">Rate Limiting</span>
      </div>

      <h4 class="subTitle">Bibliotecas</h4>
      <div class="skillsGrid">
        <span class="skillTag">Entity Framework</span>
        <span class="skillTag">Dapper</span>
        <span class="skillTag">MediatR</span>
        <span class="skillTag">AutoMapper</span>
        <span class="skillTag">FluentValidation</span>
        <span class="skillTag">FluentAssertions</span>
        <span class="skillTag">MoQ</span>
        <span class="skillTag">Memcached</span>
      </div>

      <h4 class="subTitle">Patrones de diseño</h4>
      <div class="skillsGrid">
        <span class="skillTag">Inyección de dependencias</span>
        <span class="skillTag">Mediator Pattern</span>
        <span class="skillTag">Result Pattern</span>
        <span class="skillTag">Unit of Work</span>
        <span class="skillTag">Repository Pattern</span>
        <span class="skillTag">CQRS</span>
        <span class="skillTag">Factory Pattern</span>
        <span class="skillTag">Singleton</span>
        <span class="skillTag">Specifications Pattern</span>
        <span class="skillTag">Problem Details</span>
      </div>
    </div>

    <div class="grouped">
      <h3 class="sectionTitle">Base de datos</h3>
      <div class="skillsGrid">
        <span class="skillTag">SQL Server</span>
      </div>

      <h4 class="subTitle">Conocimientos Generales</h4>
      <div class="skillsGrid">
        <span class="skillTag">Procedimientos Almacenados</span>
        <span class="skillTag">Vistas</span>
        <span class="skillTag">Índices</span>
        <span class="skillTag">Normalización</span>
        <span class="skillTag">Transacciones</span>
        <span class="skillTag">Funciones</span>
        <span class="skillTag">Jobs</span>
        <span class="skillTag">Merges</span>
        <span class="skillTag">Tipos Tabla</span>
        <span class="skillTag">CTE</span>
      </div>
    </div>
  </div>
</Accordion>

<style lang="scss">
  @use "../../styles/variables";
  @use "sass:color";

  .skills {
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 1rem 0;

    .grouped {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
  }

  .sectionTitle {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 700;
    color: rgba(variables.$text-color, 0.5);
    margin: 0;
    border-bottom: 1px solid variables.$border-color;
    padding-bottom: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .subTitle {
    font-size: 0.75rem;
    color: variables.$accent-color;
    font-weight: 600;
    margin: 0;
    opacity: 0.9;
  }

  .skillsGrid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skillTag {
    font-size: 0.8rem;
    padding: 4px 12px;
    border-radius: variables.$border-radius;
    background: rgba(variables.$accent-color, 0.1);
    color: variables.$accent-color;
    border: 1px solid rgba(variables.$accent-color, 0.2);
    transition: all 0.2s ease;
    white-space: nowrap;
    cursor: default;

    &:hover {
      background: rgba(variables.$accent-color, 0.2);
      transform: translateY(-1px);
      border-color: variables.$accent-color;
      color: variables.$text-color;
    }
  }
</style>
