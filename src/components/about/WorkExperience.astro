---
import Accordion from "../Accordion.astro";
---

<Accordion label="Experiencia laboral" className="fade-in delay-3">
  <div class="workHistoryItem">
    <div class="header">
      <div class="workRole">Desarrollador Web | Hibrido</div>
      <div class="workCompany">StarGroup</div>
      <span class="workDate">Julio 2023 - Presente</span>
    </div>

    <div class="section">
      <h4 class="sectionTitle">Responsabilidades</h4>
      <ul class="infoList">
        <li>Desarrollo y mantenimiento de aplicaciones web.</li>
        <li>Implementación de mejores prácticas de desarrollo.</li>
        <li>Automatización de procesos (Background Services/Hosted Services y Jobs SQL).</li>
      </ul>
    </div>

    <div class="section">
      <h4 class="sectionTitle">Logros Destacados</h4>
      <ul class="infoList achievements">
        <li>Desarrollé una landing page para el módulo OTT.</li>
        <li>Desarrollé una aplicación para realizar la firma del contrato de forma digital.</li>
        <li>Desarrollé un portal para capturar tickets en casetas de peaje y facturarlas usando Microsoft Dynamics.</li>
        <li>Implementación de sistema de autenticación seguro (JWT/Refresh Tokens).</li>
        <li>Implementación de arquitectura limpia.</li>
        <li>Implementación de principios S.O.L.I.D.</li>
        <li>Implementación de estándares de desarrollo para Frontend, Backend y Base de Datos.</li>
      </ul>
    </div>

    <div class="section">
      <h4 class="sectionTitle">Stack Tecnológico</h4>
      <div class="techGrid">
        <div class="techCategory">
          <span>Frontend:</span>
          <div class="tags">
            <span class="tag">React</span>
            <span class="tag">TypeScript</span>
          </div>
        </div>
        <div class="techCategory">
          <span>Backend:</span>
          <div class="tags">
            <span class="tag">.NET 7</span>
            <span class="tag">API REST</span>
            <span class="tag">Background Services</span>
          </div>
        </div>
        <div class="techCategory">
          <span>Database:</span>
          <div class="tags">
            <span class="tag">SQL Server</span>
            <span class="tag">Memcached</span>
          </div>
        </div>
        <div class="techCategory">
          <span>Tools:</span>
          <div class="tags">
            <span class="tag">GitLab</span>
            <span class="tag">Slack</span>
            <span class="tag">IIS</span>
            <span class="tag">Visual Studio</span>
            <span class="tag">Visual Studio Code</span>
            <span class="tag">ChatGPT</span>
            <span class="tag">Gemini</span>
            <span class="tag">GitHub Copilot</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="workHistoryItem">
    <div class="header">
      <div class="workRole">Desarrollador .NET | Presencial</div>
      <div class="workCompany">Tribunal Electoral del Poder Judicial de la Federación</div>
      <span class="workDate">Febrero 2022 - Marzo 2023</span>
    </div>

    <div class="section">
      <h4 class="sectionTitle">Responsabilidades</h4>
      <ul class="infoList">
        <li>Desarrollo y mantenimiento de aplicaciones web.</li>
        <li>Optimización de consultas y reafactorización de código legacy.</li>
      </ul>
    </div>

    <div class="section">
      <h4 class="sectionTitle">Logros Destacados</h4>
      <ul class="infoList achievements">
        <li>Optimicé y actualicé el Portal IUS Electoral.</li>
        <li>Desarrollé una aplicación interna que administra las prestaciones extras dadas por el tribunal.</li>
      </ul>
    </div>

    <div class="section">
      <h4 class="sectionTitle">Stack Tecnológico</h4>
      <div class="techGrid">
        <div class="techCategory">
          <span>Frontend:</span>
          <div class="tags">
            <span class="tag">React</span>
            <span class="tag">Angular</span>
            <span class="tag">TypeScript</span>
            <span class="tag">CSS</span>
          </div>
        </div>
        <div class="techCategory">
          <span>Backend:</span>
          <div class="tags">
            <span class="tag">.NET 7</span>
            <span class="tag">API REST</span>
          </div>
        </div>
        <div class="techCategory">
          <span>Database:</span>
          <div class="tags">
            <span class="tag">SQL Server</span>
            <span class="tag">Memcached</span>
          </div>
        </div>
        <div class="techCategory">
          <span>Tools:</span>
          <div class="tags">
            <span class="tag">Team Foundation Server</span>
            <span class="tag">Skype</span>
            <span class="tag">Visual Studio</span>
            <span class="tag">Visual Studio Code</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="workHistoryItem">
    <div class="header">
      <div class="workRole">Consultor Jr. | Hibrido</div>
      <div class="workCompany">Advanta Sistemas de Información</div>
      <span class="workDate">Diciembre 2018 - Enero 2022</span>
    </div>

    <div class="section">
      <h4 class="sectionTitle">Responsabilidades</h4>
      <ul class="infoList">
        <li>Desarrollo y mantenimiento de funcionalidades del E.R.P. propietario.</li>
        <li>Levantamiento de requerimientos.</li>
        <li>Automatización de procesos específicos para ciertos clientes.</li>
      </ul>
    </div>

    <div class="section">
      <h4 class="sectionTitle">Logros Destacados</h4>
      <ul class="infoList achievements">
        <li>Automaticé el proceso productivo de una empresa de procesadora de vidrio mediante el uso de códigos de barra.</li>
        <li>Desarrolle un módulo personalizable de descuentos a clientes específicos.</li>
        <li>Desarrolle diversas consultas para consultar o obtener reportes.</li>
      </ul>
    </div>

    <div class="section">
      <h4 class="sectionTitle">Stack Tecnológico</h4>
      <div class="techGrid">
        <div class="techCategory">
          <span>Frontend:</span>
          <div class="tags">
            <span class="tag">Vue</span>
            <span class="tag">JavaScript</span>
            <span class="tag">CSS</span>
          </div>
        </div>
        <div class="techCategory">
          <span>Backend:</span>
          <div class="tags">
            <span class="tag">Ruby</span>
            <span class="tag">API REST</span>
          </div>
        </div>
        <div class="techCategory">
          <span>Database:</span>
          <div class="tags">
            <span class="tag">PostgreSQL</span>
          </div>
        </div>
        <div class="techCategory">
          <span>Tools:</span>
          <div class="tags">
            <span class="tag">BitBucket</span>
            <span class="tag">Jira</span>
            <span class="tag">Skype</span>
            <span class="tag">Visual Studio</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</Accordion>

<style lang="scss">
  @use "../../styles/variables";
  @use "sass:color";

  .workHistoryItem {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid variables.$border-color;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;

    &:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }
  }

  .header {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .workRole {
    font-size: 1.25rem;
    font-weight: 700;
    color: variables.$text-color;
  }

  .workCompany {
    font-size: 1rem;
    font-weight: 600;
    color: variables.$primary-color;
  }

  .workDate {
    font-size: 0.85rem;
    color: variables.$secondary-color;
    font-family: monospace;
    opacity: 0.9;
  }

  .section {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .sectionTitle {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    font-weight: 700;
    color: rgba(variables.$text-color, 0.5);
    margin: 0;
  }

  .infoList {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;

    li {
      position: relative;
      padding-left: 1.5rem;
      color: rgba(variables.$text-color, 0.9);
      font-size: 0.95rem;
      line-height: 1.6;

      &::before {
        content: "▹";
        position: absolute;
        left: 0;
        color: variables.$accent-color;
        font-weight: bold;
      }
    }

    &.achievements li::before {
      color: variables.$accent-color;
      content: "★";
      font-size: 0.8rem;
      top: 3px;
    }
  }

  .techGrid {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .techCategory {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;

    > span {
      font-size: 0.85rem;
      color: variables.$primary-color;
      font-weight: 600;
      min-width: 80px;
    }
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.8rem;
    padding: 4px 12px;
    border-radius: variables.$border-radius;
    background: rgba(variables.$accent-color, 0.1);
    color: variables.$accent-color;
    border: 1px solid rgba(variables.$accent-color, 0.2);
    transition: all 0.2s ease;
    white-space: nowrap;
    cursor: default;

    &:hover {
      background: rgba(variables.$accent-color, 0.2);
      transform: translateY(-1px);
      border-color: variables.$accent-color;
      color: variables.$text-color;
    }
  }

  @media (max-width: 640px) {
    .techCategory {
      flex-direction: column;
      gap: 0.4rem;

      > span {
        font-size: 0.75rem;
        opacity: 0.7;
      }
    }
  }
</style>
